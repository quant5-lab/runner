{
  "_comment": "Aroon+RSI break ensemble. Panes: main, aroon, ensemble.",
  "panes": {
    "main": { "height": 520, "fixed": true },
    "aroon": { "height": 150, "fixed": false },
    "ensemble": { "height": 110, "fixed": false }
  },
  "indicators": {
    "SL": { "pane": "main", "style": "line", "color": "#F44336", "lineWidth": 2, "lineStyle": "dashed" },
    "TP": { "pane": "main", "style": "line", "color": "#4CAF50", "lineWidth": 2, "lineStyle": "dashed" },
    "Buy Signal": { "pane": "main", "style": "circles", "color": "#00E676", "lineWidth": 2 },
    "Sell Signal": { "pane": "main", "style": "circles", "color": "#FF5252", "lineWidth": 2 },
    "Aroon Up": { "pane": "aroon", "style": "line", "color": "#FF9800", "lineWidth": 2 },
    "Aroon Down": { "pane": "aroon", "style": "line", "color": "#2196F3", "lineWidth": 2 },
    "Ensemble Weight Up": { "pane": "ensemble", "style": "histogram", "color": "rgba(0,230,118,0.5)" },
    "Ensemble Weight Down": { "pane": "ensemble", "style": "histogram", "color": "rgba(255,82,82,0.5)" }
  }
}
