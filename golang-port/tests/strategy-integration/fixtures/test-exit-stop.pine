//@version=4
strategy("Exit Stop Test", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

stop_price = 105.0

if close > 105.0 and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("StopExit", "Long", stop=stop_price)
