//@version=4
strategy("Position Reversal Test", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

if close > 105.0 and strategy.position_size <= 0
    strategy.close_all()
    strategy.entry("Long", strategy.long)

if close < 108.0 and strategy.position_size > 0
    strategy.close_all()
    strategy.entry("Short", strategy.short)
