//@version=4
strategy("Avg Price Condition Test", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

if close > 105.0 and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_avg_price > 0.0 and close < strategy.position_avg_price * 0.99
    strategy.close("Long")
