//@version=5
indicator("bar_index in security() - CRITICAL", overlay=false)

// CRITICAL TEST: bar_index inside security() context
// This is the exact bb9 bug pattern that was failing

// Test 1: bar_index in security context (basic)
secBarIndex = security(syminfo.tickerid, "1D", bar_index)

// Test 2: bar_index % 20 in security (exact bb9 pattern)
secMod20Condition = security(syminfo.tickerid, "1D", (bar_index % 20) == 0)
secMod20Value = security(syminfo.tickerid, "1D", bar_index % 20)

// Test 3: bar_index arithmetic in security
secDoubled = security(syminfo.tickerid, "1D", bar_index * 2)

// Test 4: bar_index comparison in security
secGtTen = security(syminfo.tickerid, "1D", bar_index > 10)

plot(secBarIndex, "Security Bar Index", color=color.blue)
plot(secMod20Condition ? 1 : 0, "Security Mod 20", color=color.red)
plot(secMod20Value, "Security Mod 20 Value", color=color.green)
plot(secDoubled, "Security Doubled", color=color.orange)
plot(secGtTen ? 1 : 0, "Security > 10", color=color.purple)
