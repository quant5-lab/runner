//@version=5
indicator("Test Calendar Functions", overlay=false)

// Fixture epoch: 1640000000 sec = 2021-12-20 UTC (daily bars through 2022).
y  = year(time)
mo = month(time)
dw = dayofweek(time)
dm = dayofmonth(time)
hr = hour(time)
mn = minute(time)
sc = second(time)
wk = weekofyear(time)

t         = time()
t1d       = time("D")
y_via_t   = year(t)
y_via_t1d = year(t1d)

// Plot one of them to keep pine-gen happy; the others must compile and run.
plot(y, "year")
plot(mo, "month")
plot(dw, "dayofweek")
plot(dm, "dayofmonth")
plot(hr, "hour")
plot(y_via_t, "year_via_t")
plot(y_via_t1d, "year_via_t1d")
