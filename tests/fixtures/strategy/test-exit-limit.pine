//@version=4
strategy("Exit Limit Test", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

limit_price = 110.0

if close > 105.0 and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("LimitExit", "Long", limit=limit_price)
