//@version=4
strategy("Close All Test", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

if close > 105.0 and strategy.position_size == 0
    strategy.entry("Long1", strategy.long)
    strategy.entry("Long2", strategy.long)

if close < 108.0 and strategy.position_size > 0
    strategy.close_all()
