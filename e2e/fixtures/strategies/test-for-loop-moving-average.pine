//@version=5
indicator("Custom MA with For Loop", overlay=true)

// Custom moving average calculation using for loop
length = input.int(20, "Length", minval=1)

customMA(src, len) =>
    sum = 0.0
    for i = 0 to len - 1
        sum := sum + src[i]
    sum / len

ma = customMA(close, length)
plot(ma, "Custom MA", color=color.blue, linewidth=2)

// Compare with built-in SMA
sma20 = ta.sma(close, length)
plot(sma20, "Built-in SMA", color=color.red, linewidth=1)
