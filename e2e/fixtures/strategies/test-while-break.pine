//@version=5
strategy("While Break", overlay=true)

lookback = input.int(20, "Lookback")

sum = 0.0
idx = 1
while idx <= lookback
    if idx > 10
        break
    sum := sum + idx
    idx := idx + 1

if bar_index > 0 and close > open and sum == 55
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and bar_index % 15 == 0
    strategy.close("Long")
