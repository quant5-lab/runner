//@version=5
indicator("Weighted Average with For Loop", overlay=true)

// Custom weighted moving average using for loop
length = input.int(10, "Length", minval=1)

customWMA(src, len) =>
    weightedSum = 0.0
    weightTotal = 0
    for i = 0 to len - 1
        weight = len - i
        weightedSum := weightedSum + src[i] * weight
        weightTotal := weightTotal + weight
    weightedSum / weightTotal

wma = customWMA(close, length)
plot(wma, "Custom WMA", color=color.purple, linewidth=2)

// Compare with built-in WMA
wma10 = ta.wma(close, length)
plot(wma10, "Built-in WMA", color=color.orange, linewidth=1)
